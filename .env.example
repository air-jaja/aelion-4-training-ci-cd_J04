# [PÉDAGOGIE] ============================================================================
# [PÉDAGOGIE] FICHIER — .env.example
# [PÉDAGOGIE] MODULE  — M23–M26 — configuration externe et principes 12-factor
# [PÉDAGOGIE] RÔLE    — Documenter les noms de variables attendues sans versionner de valeur
# [PÉDAGOGIE]           secrète réelle.
# [PÉDAGOGIE] THÉORIE — le code reste identique entre environnements ; seules les valeurs changent
# [PÉDAGOGIE]           • un exemple décrit un contrat de configuration, pas des identifiants
# [PÉDAGOGIE]             réels
# [PÉDAGOGIE]           • la validation à la frontière doit échouer clairement si une valeur
# [PÉDAGOGIE]             obligatoire manque
# [PÉDAGOGIE] À VOIR  — La copie locale .env est lue au runtime et doit rester hors de Git.
# [PÉDAGOGIE] PIÈGE   — Ne jamais remplacer une valeur d'exemple par une clé, un mot de passe ou
# [PÉDAGOGIE]           un jeton réel.
# [PÉDAGOGIE] GARDE   — Toutes les lignes marquées [PÉDAGOGIE] sont des commentaires : elles
# [PÉDAGOGIE]           guident la lecture sans changer l'exécution.
# [PÉDAGOGIE] ============================================================================

# [PÉDAGOGIE] VARIABLE `INDUSENSE_DATA_DIR` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_DATA_DIR=data/raw
# [PÉDAGOGIE] VARIABLE `INDUSENSE_GOLD_DIR` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_GOLD_DIR=data/gold
# [PÉDAGOGIE] VARIABLE `INDUSENSE_MODEL_DIR` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_MODEL_DIR=artifacts/models
# [PÉDAGOGIE] VARIABLE `INDUSENSE_RANDOM_SEED` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_RANDOM_SEED=42
# [PÉDAGOGIE] VARIABLE `INDUSENSE_TARGET_COL` — nom du réglage attendu ; conserver ici une valeur
# [PÉDAGOGIE] factice non sensible.
INDUSENSE_TARGET_COL=panne
# [PÉDAGOGIE] VARIABLE `INDUSENSE_INCIDENT_WINDOW_HOURS` — nom du réglage attendu ; conserver ici
# [PÉDAGOGIE] une valeur factice non sensible.
INDUSENSE_INCIDENT_WINDOW_HOURS=24
# HRA
INDUSENSE_REQUIRE_MODEL_HASH=false
